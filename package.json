{
  "name": "aone-ide",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@12.0.1",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=12.0.1 <13"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --pretty false",
    "build": "tsc -b && vite build",
    "size": "node scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "test": "vitest run --exclude scripts/tests/release-security.test.mjs",
    "test:watch": "vitest",
    "test:rust": "cargo test --locked --manifest-path src-tauri/Cargo.toml --all-targets",
    "test:release-security": "node --test scripts/tests/release-security.test.mjs",
    "test:site": "node scripts/check-release-version.mjs && node scripts/test-download-site.mjs && npm run test:release-security",
    "openapi:generate": "node scripts/openapi/generate.mjs",
    "openapi:check": "node scripts/openapi/check.mjs",
    "openapi:docs": "node scripts/openapi/docs.mjs",
    "asyncapi:check": "node scripts/asyncapi/check.mjs",
    "structure": "node scripts/check-structure.mjs",
    "lint:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "check": "npm run structure && npm run openapi:check && npm run asyncapi:check && npm run build && npm run size && npm run test && npm run test:site && npm run lint:rust && npm run test:rust",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "dmg": "CI=true tauri build --bundles dmg",
    "release:macos": "/usr/bin/env -u BASH_ENV -u ENV -u SHELLOPTS /bin/bash --noprofile --norc scripts/release-macos.sh --public",
    "release:macos:test": "/usr/bin/env -u BASH_ENV -u ENV -u SHELLOPTS /bin/bash --noprofile --norc scripts/release-macos.sh --local-test",
    "release:verify": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@monaco-editor/react": "4.7.0",
    "@phosphor-icons/react": "2.1.10",
    "@tauri-apps/api": "2.11.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-drag": "3.0.0",
    "d3-force": "3.0.0",
    "d3-selection": "3.0.0",
    "d3-zoom": "3.0.0",
    "monaco-editor": "0.56.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.12.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/d3-drag": "3.0.7",
    "@types/d3-force": "3.0.10",
    "@types/d3-selection": "3.0.11",
    "@types/d3-zoom": "3.0.8",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "28.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.0"
  },
  "overrides": {
    "dompurify": "3.4.13"
  }
}
